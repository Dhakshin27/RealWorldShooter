<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Gradient Background -->
    <gradient
        android:startColor="#FF3B2F"
        android:endColor="#FF6A00"
        android:angle="0" />

    <!-- Rounded Corners -->
    <corners android:radius="20dp" />

    <!-- Optional Shadow -->
    <padding
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp" />

</shape>
