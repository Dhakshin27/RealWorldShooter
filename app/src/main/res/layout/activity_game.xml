    <com.example.realworldshooter.SemiCircleLayout
        android:id="@+id/weaponWheel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:alpha="0"
        android:padding="0dp"
        app:layout_constraintBottom_toTopOf="@id/shootButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">



    <ImageView
            android:id="@+id/weaponPistol"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/gun"/>

        <ImageView
            android:id="@+id/weaponShotgun"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/shotgun"/>

        <ImageView
            android:id="@+id/weaponSniper"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/smg2"/>

        <ImageView
            android:id="@+id/weaponSmg"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/submachine"/>

        <ImageView
            android:id="@+id/weaponAr"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/rifle"/>

    </com.example.realworldshooter.SemiCircleLayout>

