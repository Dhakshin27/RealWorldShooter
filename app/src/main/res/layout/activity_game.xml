    <ImageButton
        android:id="@+id/shootButton"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_shoot"
        android:background="@android:color/transparent"
        android:contentDescription="Shoot"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="30dp"/>
    <ImageButton
        android:id="@+id/reloadButton"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/reload"
        android:background="@android:color/transparent"
        android:contentDescription="Reload"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/shootButton"
        app:layout_constraintStart_toEndOf="@id/shootButton"
        android:layout_marginStart="30dp"/>
    <TextView
        android:id="@+id/ammoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ammo: 12/12"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/reloadButton"
        app:layout_constraintStart_toEndOf="@id/reloadButton"
        android:layout_marginStart="-85dp"
        android:layout_marginTop="0dp" />



