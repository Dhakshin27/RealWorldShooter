<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <ImageView
        android:id="@+id/logoIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="88dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/target"
        app:tint="#FF4A3D"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/titleMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/montserrat_bold"
        android:text="REAL WORLD"
        android:textColor="#332323"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/logoIcon"
        app:layout_constraintTop_toTopOf="@id/logoIcon" />


    <!-- ===== MAIN BIG BUTTONS ===== -->

    <!-- HOST GAME button -->
    <TextView
        android:id="@+id/titleSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:fontFamily="@font/montserrat_semibold"
        android:text="SHOOTER"
        android:textColor="#FF7B31"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/titleMain"
        app:layout_constraintTop_toBottomOf="@id/titleMain" />

    <TextView
        android:id="@+id/modeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:letterSpacing="0.04"
        android:text="●  AR PVP COMBAT"
        android:textColor="#26E6A4"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/titleSub"
        app:layout_constraintTop_toBottomOf="@id/titleSub" />

    <!-- JOIN GAME button -->
    <LinearLayout
        android:id="@+id/hostCard"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="208dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_host_button"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/modeText">

        <ImageView
            android:id="@+id/hostIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/podcast"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:id="@+id/hostTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOST GAME"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hostSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create a new match"
                android:textColor="#FFE0E0"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/joinCard"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/bg_join_button"
        app:layout_constraintTop_toBottomOf="@id/hostCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp">

        <ImageView
            android:id="@+id/joinIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/join"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:id="@+id/joinTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JOIN GAME"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/joinSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find nearby matches"
                android:textSize="13sp"
                android:textColor="#E0F3FF"/>
        </LinearLayout>
    </LinearLayout>

    <!-- EXIT bar -->
    <LinearLayout
        android:id="@+id/exitBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_exit_button"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/joinCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/exit"
            android:layout_marginEnd="8dp"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXIT"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- ===== BOTTOM STATUS TEXT ===== -->

    <LinearLayout
        android:id="@+id/statusRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Blue dot -->
        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="#27C6FF"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:shape="oval"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P2P Connection"
            android:textSize="11sp"
            android:textColor="#A0B3D7"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  •  "
            android:textSize="11sp"
            android:textColor="#A0B3D7"/>

        <!-- Red dot -->
        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="#FF4A3D"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:shape="oval"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Real-time Combat"
            android:textSize="11sp"
            android:textColor="#A0B3D7"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
